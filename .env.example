# ============================================================
# WallDex Exchange — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=3002
APP_ID=walldex

# --- Database (MySQL/TiDB) ---
DATABASE_URL=mysql://user:password@localhost:3306/walldex

# --- JWT Session Secret (min 32 chars in production) ---
JWT_SECRET=your-random-secret-at-least-32-characters-long

# --- Owner (gets admin role on first login) ---
OWNER_ADDRESS=0xYourWalletAddress

# --- Rabbit App Bridge ---
RABBIT_APP_ADDRESS=0xAppSignerPublicAddress
RABBIT_MAX_SKEW_SECONDS=60

# --- SIWE (Sign-In with Ethereum) ---
SIWE_DOMAIN=walldex.io
SIWE_URI=https://walldex.io
SIWE_STATEMENT=Sign in to WallDex Exchange with your Rabbit Wallet
SIWE_CHAIN_ID=1
SIWE_EXPIRATION_MINUTES=10

# --- Exchange: Market Data ---
MARKET_DATA_SOURCES=binance,okx,hyperliquid
MARKET_DATA_PROXY_URL=

# --- Exchange: Hedging (optional) ---
HEDGE_BINANCE_KEY=
HEDGE_BINANCE_SECRET=
HEDGE_OKX_KEY=
HEDGE_OKX_SECRET=
HEDGE_OKX_PASSPHRASE=
HEDGE_MAX_LEG_NOTIONAL_USDT=50000

# --- Exchange: Wallet Sync ---
WALLET_SYNC_SECRET=your-random-secret-for-wallet-sync
WALLET_SYNC_MAX_SKEW_SECONDS=300

# --- Exchange: HD Wallet (for deposit address generation) ---
HD_WALLET_MNEMONIC=
HD_WALLET_XPUB=
HD_WALLET_ACCOUNT_INDEX=0

# --- Exchange: API Rate Limiting ---
API_RATE_LIMIT_PER_MIN=600
API_RATE_LIMIT_BURST=120
